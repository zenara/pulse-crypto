# Leave empty in source. Set per environment, not in application code.
#
# Android emulator reaches the host machine at 10.0.2.2, not localhost.
# iOS simulator can use localhost. Physical devices need the host LAN IP.
#
# Examples:
#   EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
#   EXPO_PUBLIC_WS_URL=ws://10.0.2.2:3000/market
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_WS_URL=
