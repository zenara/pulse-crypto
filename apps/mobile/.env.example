# Android emulator reaches the host at 10.0.2.2, not localhost.
# iOS simulator: http://localhost:3000 and ws://localhost:3000/market
# Physical device: use the host LAN IP instead of 10.0.2.2.
#
# Restart Metro after changing this file (`pnpm nx start mobile`).

EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
EXPO_PUBLIC_WS_URL=ws://10.0.2.2:3000/market
